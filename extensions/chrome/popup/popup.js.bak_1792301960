function renderUIForUrl(tabUrl) {
    if (!tabUrl || tabUrl.startsWith('chrome://') || tabUrl.startsWith('chrome-extension://')) return;

    let hostname = "";
    try { hostname = new URL(tabUrl).hostname; } catch(e) { return; }

    // 1. 更新域名
    const domainEls = document.querySelectorAll('#current-domain, .current-domain');
    domainEls.forEach(el => {
        if (el.textContent !== hostname) el.textContent = hostname;
    });

    // 2. 获取设置并更新开关与文字
    chrome.runtime.sendMessage({ type: 'GET_SETTINGS' }, (settings) => {
        if (!settings) return;
        const isPaused = (settings.whitelist || []).includes(hostname) || 
                         (settings.tempWhitelist || []).includes(hostname);

        const toggle = document.getElementById('domain-toggle');
        if (toggle) toggle.checked = !isPaused;

        const statusEls = document.querySelectorAll('#domain-status, .domain-status');
        statusEls.forEach(el => {
            const txt = isPaused ? '保护已暂停' : '保护已开启';
            if (el.textContent !== txt) el.textContent = txt;
        });

        const badges = document.querySelectorAll('#top-badge, .status-badge');
        badges.forEach(badge => {
            const txt = isPaused ? '已暂停' : '保护中';
            if (badge.textContent !== txt) badge.textContent = txt;
            
            if (isPaused) {
                badge.classList.add('paused'); badge.classList.remove('active');
            } else {
                badge.classList.add('active'); badge.classList.remove('paused');
            }
        });
    });
}

// 监听后台发来的 TAB_CHANGED 消息
chrome.runtime.onMessage.addListener((message) => {
    if (message.type === 'TAB_CHANGED') {
        renderUIForUrl(message.url);
    }
});

