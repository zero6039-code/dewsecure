async function updateSidePanelUI() {
    try {
        // 1. 强制获取当前窗口下真正激活的标签页
        const [tab] = await chrome.tabs.query({ active: true, currentWindow: true });
        if (!tab || !tab.url || tab.url.startsWith('chrome://') || tab.url.startsWith('chrome-extension://')) return;

        let hostname = "";
        try {
            hostname = new URL(tab.url).hostname;
        } catch(e) { return; }

        // 2. 精准更新域名（使用 textContent 赋值，绝不累加，杜绝重影）
        const domainEls = document.querySelectorAll('#current-domain, .current-domain');
        domainEls.forEach(el => {
            if (el.textContent !== hostname) {
                el.textContent = hostname; 
            }
        });

        // 3. 从后台获取最真实的白名单设置
        chrome.runtime.sendMessage({ type: 'GET_SETTINGS' }, (settings) => {
            if (!settings) return;
            const isPaused = (settings.whitelist || []).includes(hostname) || 
                             (settings.tempWhitelist || []).includes(hostname);

            // 4. 更新 Toggle 开关（只改 checked 属性）
            const toggle = document.getElementById('domain-toggle');
            if (toggle) {
                toggle.checked = !isPaused;
            }

            // 5. 更新状态文字（保护已暂停 / 保护已开启）
            const statusEls = document.querySelectorAll('#domain-status, .domain-status');
            statusEls.forEach(el => {
                const txt = isPaused ? '保护已暂停' : '保护已开启';
                if (el.textContent !== txt) el.textContent = txt;
            });

            // 6. 更新右上角徽章（已暂停 / 保护中）
            const badges = document.querySelectorAll('#top-badge, .status-badge');
            badges.forEach(badge => {
                const txt = isPaused ? '已暂停' : '保护中';
                if (badge.textContent !== txt) badge.textContent = txt;
                
                // 同步颜色 Class
                if (isPaused) {
                    badge.classList.add('paused');
                    badge.classList.remove('active');
                } else {
                    badge.classList.add('active');
                    badge.classList.remove('paused');
                }
            });
        });
    } catch(e) {
        console.warn('Side panel sync error:', e);
    }
}

