{
  "manifest_version": 3,
  "name": "DewSecure - 安全内容净化引擎",
  "version": "0.3.0",
  "description": "基于设备端 AI 与联邦学习，保护您免受恶意广告、钓鱼追踪和骚扰弹窗的侵害。数据不出设备，隐私完全自主。",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "alarms",
    "scripting",
    "tabs",
    "offscreen",
    "sidePanel",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://cdn.dewsecure.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads_1a",
        "enabled": true,
        "path": "rules/ads-1a.json"
      },
      {
        "id": "ads_1b",
        "enabled": true,
        "path": "rules/ads-1b.json"
      },
      {
        "id": "ads_2",
        "enabled": true,
        "path": "rules/ads-2.json"
      },
      {
        "id": "ads_3",
        "enabled": true,
        "path": "rules/ads-3.json"
      },
      {
        "id": "trackers_1a",
        "enabled": true,
        "path": "rules/trackers-1a.json"
      },
      {
        "id": "trackers_1b",
        "enabled": true,
        "path": "rules/trackers-1b.json"
      },
      {
        "id": "trackers_2a",
        "enabled": true,
        "path": "rules/trackers-2a.json"
      },
      {
        "id": "trackers_2b",
        "enabled": true,
        "path": "rules/trackers-2b.json"
      },
      {
        "id": "annoyances",
        "enabled": false,
        "path": "rules/annoyances.json"
      },
      {
        "id": "anti_affiliate",
        "enabled": true,
        "path": "rules/anti-affiliate.json"
      },
      {
        "id": "ads_4",
        "enabled": true,
        "path": "rules/ads-4.json"
      }
    ]
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/inject.js",
        "wasm/*.wasm",
        "wasm/*.mjs",
        "models/*.onnx"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "side_panel": {
    "default_path": "popup/index.html"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}