{
  "manifest_version": 3,
  "name": "DewSecure - Content Optimizer",
  "version": "1.2.8",
  "description": "On-device AI + 110,000+ rules. Stop phishing redirects, trackers, and intrusive popups. Privacy-first.",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "storage",
    "alarms",
    "webNavigation",
    "downloads",
    "notifications",
    "scripting",
    "webRequest",
    "webRequestBlocking"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://api.dewsecure.com https://*.supabase.co https://cdn.dewsecure.com https://dewsecure-api.zero6039.workers.dev http://* https://*;"
  },
  "background": {
    "scripts": [
      "src/background.js"
    ],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads_1a",
        "enabled": true,
        "path": "rules/ads-1a.json"
      },
      {
        "id": "ads_1b",
        "enabled": true,
        "path": "rules/ads-1b.json"
      },
      {
        "id": "ads_2",
        "enabled": true,
        "path": "rules/ads-2.json"
      },
      {
        "id": "ads_3",
        "enabled": true,
        "path": "rules/ads-3.json"
      },
      {
        "id": "ads_4",
        "enabled": true,
        "path": "rules/ads-4.json"
      },
      {
        "id": "trackers_1a",
        "enabled": true,
        "path": "rules/trackers-1a.json"
      },
      {
        "id": "trackers_1b",
        "enabled": true,
        "path": "rules/trackers-1b.json"
      },
      {
        "id": "trackers_2a",
        "enabled": true,
        "path": "rules/trackers-2a.json"
      },
      {
        "id": "trackers_2b",
        "enabled": true,
        "path": "rules/trackers-2b.json"
      },
      {
        "id": "anti_affiliate",
        "enabled": true,
        "path": "rules/anti-affiliate.json"
      },
      {
        "id": "annoyances",
        "enabled": false,
        "path": "rules/annoyances.json"
      },
      {
        "id": "allowlist",
        "enabled": true,
        "path": "rules/allowlist.json"
      }
    ]
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "warning.html",
        "src/content.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "minimum_chrome_version": "114",
  "sidebar_action": {
    "default_panel": "popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "dewsecure@dewsecure.com",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}