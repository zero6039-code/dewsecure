<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 正常应用主题 -->
    <style name="Theme.DewSecure" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 🌟 核心：让 Activity 启动的背景直接就是你的深色渐变，彻底防白屏 -->
        <item name="android:windowBackground">@drawable/bg_splash_tech</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- 启动页主题：直接继承正常主题，不需要系统遮罩 -->
    <style name="Theme.DewSecure.Splash" parent="Theme.DewSecure">
        <item name="android:windowFullscreen">false</item>
    </style>
</resources>
