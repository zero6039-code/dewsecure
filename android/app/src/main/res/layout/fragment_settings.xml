<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="20dp" />

    <!-- 大毛玻璃卡片容器 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card"
        android:orientation="horizontal"
        android:paddingVertical="12dp"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <!-- 左侧图标导航栏 -->
        <LinearLayout
            android:layout_width="48dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="start">

            <LinearLayout
                android:id="@+id/tab_lang"
                android:layout_width="44dp" android:layout_height="44dp"
                android:gravity="center" android:background="@drawable/bg_glass_tab_active"
                android:layout_marginBottom="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌐" android:textSize="20sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tab_whitelist"
                android:layout_width="44dp" android:layout_height="44dp"
                android:gravity="center" android:background="@drawable/bg_glass_tab_inactive"
                android:layout_marginBottom="12dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🛡️" android:textSize="20sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tab_privacy"
                android:layout_width="44dp" android:layout_height="44dp"
                android:gravity="center" android:background="@drawable/bg_glass_tab_inactive">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔒" android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 分割线 -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="@color/glass_stroke"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="16dp" />

        <!-- 右侧内容区 -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="300dp">

            <!-- 语言页面 -->
            <LinearLayout
                android:id="@+id/pane_lang" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="visible">
                <GridLayout
                    android:id="@+id/grid_language" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:columnCount="3" android:alignmentMode="alignMargins" android:useDefaultMargins="true"/>
            </LinearLayout>

            <!-- 白名单页面 -->
            <LinearLayout
                android:id="@+id/pane_whitelist" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone">
                
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Whitelist" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="16sp" android:layout_marginBottom="4dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Domains here will stop all protection." android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="16dp"/>

                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="16dp">
                    
                    <EditText
                        android:id="@+id/et_whitelist_domain" android:layout_width="0dp" android:layout_height="40dp"
                        android:layout_weight="1" android:background="@drawable/bg_glass_card" android:hint="example.com"
                        android:paddingHorizontal="12dp" android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary"
                        android:textSize="14sp" android:inputType="textUri" android:layout_marginEnd="8dp"/>

                    <!-- 安全的普通 Button 配合圆角背景 -->
                    <Button
                        android:id="@+id/btn_add_whitelist" android:layout_width="wrap_content" android:layout_height="40dp"
                        android:text="ADD" android:textColor="#000000" android:textStyle="bold" android:textSize="13sp"
                        android:background="@drawable/bg_btn_green_rounded" android:minWidth="0dp" android:paddingHorizontal="16dp"
                        android:stateListAnimator="@null"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_whitelist_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:text="No whitelist yet" android:textColor="@color/text_secondary" android:textSize="12sp"
                    android:gravity="center" android:paddingVertical="12dp" android:visibility="gone"/>

                <LinearLayout
                    android:id="@+id/container_whitelist" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
            </LinearLayout>

            <!-- 隐私页面 -->
            <LinearLayout
                android:id="@+id/pane_privacy" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Share Threat Intel (Anonymous)" android:textColor="@color/text_primary" android:textStyle="bold" android:textSize="16sp" android:layout_marginBottom="8dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Allow sending desensitized suspicious domains to the cloud to improve blocking. Default off." android:textColor="@color/text_secondary" android:textSize="12sp" android:layout_marginBottom="16dp"/>
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switch_share_threat" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
