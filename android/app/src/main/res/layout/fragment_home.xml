<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:clipToPadding="false"
                android:paddingTop="10dp"
                android:paddingBottom="40dp"
                android:layout_gravity="center"
                android:maxWidth="500dp">

                <!-- 顶部：Logo + 登录按钮 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="32dp">

                    <ImageView
                        android:id="@+id/iv_logo"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/dewsecure_icon" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="DewSecure"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_login"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_login"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:background="@drawable/bg_glass_card"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp" />
                </LinearLayout>

                <!-- 核心状态区 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_status_unprotected"
                    android:id="@+id/tv_main_status"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tv_main_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/home_main_title"
                    android:textColor="@color/text_primary"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="16dp"/>

                <!-- 数据卡片 (今日/总拦截 - 左字右数版) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <!-- 今日拦截 -->
                    <LinearLayout
                        android:id="@+id/card_blocked_today"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:background="@drawable/bg_glass_card"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="12dp"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/tv_blocked_today_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/home_blocked_today"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"/>
                        <TextView
                            android:id="@+id/tv_blocked_today"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"/>
                    </LinearLayout>

                    <!-- 总拦截 -->
                    <LinearLayout
                        android:id="@+id/card_blocked_total"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_glass_card"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="20dp"
                        android:paddingVertical="12dp"
                        android:orientation="horizontal">
                        <TextView
                            android:id="@+id/tv_blocked_total_label"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/home_blocked_total"
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp"/>
                        <TextView
                            android:id="@+id/tv_blocked_total"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- 流量统计：合并为一个框 -->
                <LinearLayout
                    android:id="@+id/card_traffic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_card"
                    android:orientation="horizontal"
                    android:paddingVertical="16dp"
                    android:layout_marginBottom="16dp">

                    <!-- 今日节省 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tv_traffic_today"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="0 KB"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@color/accent_blue"
                            android:gravity="center"
                            android:maxLines="1"
                            app:autoSizeTextType="uniform"
                            app:autoSizeMinTextSize="14sp"
                            app:autoSizeMaxTextSize="24sp"/>
                        <TextView
                            android:id="@+id/tv_saved_today_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_saved_today"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <!-- 竖线分割 -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:background="@color/glass_stroke"
                        android:layout_marginVertical="8dp"/>

                    <!-- 总节省 -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/tv_traffic_total"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="0 KB"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="@color/accent_blue"
                            android:gravity="center"
                            android:maxLines="1"
                            app:autoSizeTextType="uniform"
                            app:autoSizeMinTextSize="14sp"
                            app:autoSizeMaxTextSize="24sp"/>
                        <TextView
                            android:id="@+id/tv_saved_total_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_saved_total"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- 开关按钮 -->
                <com.dewsecure.android.ui.view.HoneycombButton
                    android:id="@+id/btn_toggle_vpn"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="@string/home_btn_start"
                    android:layout_marginBottom="16dp"/>

                <!-- 反馈 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass_card"
                    android:padding="20dp"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/tv_help_improve"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_help_improve"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginBottom="12dp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_missed_ad"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="40dp"
                            android:text="@string/home_missed_ad"
                            android:background="@drawable/bg_btn_glass"
                            android:textColor="@color/text_primary"
                            android:maxLines="1"
                            android:paddingHorizontal="4dp"
                            app:autoSizeTextType="uniform"
                            app:autoSizeMinTextSize="10sp"
                            app:autoSizeMaxTextSize="12sp"
                            android:layout_marginEnd="8dp"/>
                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_false_block"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="40dp"
                            android:text="@string/home_false_block"
                            android:background="@drawable/bg_btn_glass"
                            android:textColor="@color/text_primary"
                            android:maxLines="1"
                            android:paddingHorizontal="4dp"
                            app:autoSizeTextType="uniform"
                            app:autoSizeMinTextSize="10sp"
                            app:autoSizeMaxTextSize="12sp"
                            android:layout_marginStart="8dp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</ScrollView>
